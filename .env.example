# Phone numbers allowed to submit receipts (comma-separated, E.164 format)
# Local: set in functions/.env
# Production: firebase deploy --set-env-vars ALLOWED_PHONES="+16475550123"
ALLOWED_PHONES=+16475550123

# For local emulator testing only — secrets are handled by Firebase Secret Manager in prod
# Set secrets with: firebase functions:secrets:set TWILIO_ACCOUNT_SID etc.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GEMINI_API_KEY=
