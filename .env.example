# Your phone number in E.164 format (e.g. +14165551234)
# Local: set in functions/.env
# Production: store in Firebase Secret Manager as ALLOWED_PHONES
ALLOWED_PHONES=+14165551234

# Exact webhook URL configured in Twilio.
# Production: store in Firebase Secret Manager as WEBHOOK_URL
WEBHOOK_URL=https://your-sms-webhook-url.example.com

# Optional smoke-test sender. Defaults to the first phone in ALLOWED_PHONES.
SMOKE_FROM=+14165551234

# For local emulator testing only — secrets are handled by Firebase Secret Manager in prod
# Set secrets with: firebase functions:secrets:set TWILIO_ACCOUNT_SID etc.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
GEMINI_API_KEY=

# Optional local Firestore auth for admin scripts like replay/query/delete.
# You can also use GOOGLE_APPLICATION_CREDENTIALS instead.
FIREBASE_SERVICE_ACCOUNT_PATH=
