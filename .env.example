# Your Telegram chat ID (find it by messaging @userinfobot on Telegram)
# Local: set in functions/.env
# Production: firebase deploy --set-env-vars ALLOWED_CHATS="123456789"
ALLOWED_CHATS=123456789

# For local emulator testing only — secrets are handled by Firebase Secret Manager in prod
# Set secrets with: firebase functions:secrets:set TELEGRAM_BOT_TOKEN etc.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
GEMINI_API_KEY=
